import java.util.Scanner;
import java.io.*;

public class program63_1
{
    public static void main(String[] args) throws Exception
    {
        Scanner sobj = new Scanner(System.in);

        System.out.print("Enter source file name : ");
        String src = sobj.nextLine();

        System.out.print("Enter destination file name : ");
        String dest = sobj.nextLine();

        FileInputStream fiobj = new FileInputStream(src);
        BufferedInputStream biobj = new BufferedInputStream(fiobj);

        FileOutputStream foobj = new FileOutputStream(dest);
        BufferedOutputStream boobj = new BufferedOutputStream(foobj);

        int data = 0;

        while((data = biobj.read()) != -1)
        {
            boobj.write(data);
        }




        boobj.flush();

        System.out.println("File copied using bufferedreaderClass");
    }
}
